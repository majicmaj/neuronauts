  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main launch, transmit, return, and rematch action.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\"><svg class=\"ds-glyph\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19h4v2H2v-8h2v6Zm8 0H8v-2h4v2Zm4-2h-4v-2h4v2Zm4-2h-4v-2h4v2Zm-10-2H4v-2h6v2Zm12 0h-2v-2h2v2ZM8 5H4v6H2V3h6v2Zm12 6h-4V9h4v2Zm-4-2h-4V7h4v2Zm-4-2H8V5h4v2Z\"/></svg>Transmit guess</button>",
      "css": ".ds-btn-primary { min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid var(--accent,#087f70);border-radius:10px;background:var(--accent,#087f70);padding:.7rem 1.15rem;color:var(--accent-contrast,#fff);font:700 1rem/1.2 \"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out; }.ds-btn-primary:hover { border-color:var(--accent-hover,#06695e);background:var(--accent-hover,#06695e); }.ds-btn-primary:focus-visible { outline:2px solid var(--accent,#087f70);outline-offset:3px; }.ds-btn-primary:active { transform:translateY(1px); }.ds-glyph { width:24px;height:24px;fill:currentColor;shape-rendering:crispEdges; }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting action that stays quiet until hover or focus.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Randomize teams</button>",
      "css": ".ds-btn-secondary { min-height:44px;border:1px solid var(--line-strong,#aebdb7);border-radius:10px;background:var(--surface-subtle,#f6f8f7);padding:0 1.25rem;color:var(--ink,#17201d);font:700 .875rem/1.2 \"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;transition:border-color 150ms ease-out,color 150ms ease-out,background-color 150ms ease-out; }.ds-btn-secondary:hover { border-color:var(--accent,#087f70);color:var(--accent,#087f70); }.ds-btn-secondary:focus-visible { outline:2px solid var(--accent,#087f70);outline-offset:3px; }.ds-btn-secondary:active { background:var(--accent-soft,#dff1ed); }"
    },
    {
      "name": "Mission Input",
      "kind": "input",
      "refersTo": "input-mission",
      "description": "Single-word semantic transmission field.",
      "html": "<label class=\"ds-field-label\" for=\"ds-guess\">Guess a word</label><input class=\"ds-mission-input\" id=\"ds-guess\" type=\"text\" maxlength=\"40\" placeholder=\"Plot a word\u2026\" />",
      "css": ".ds-field-label { display:block;margin-bottom:.5rem;color:var(--ink,#17201d);font:700 .875rem/1.3 \"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif; }.ds-mission-input { width:100%;min-height:48px;border:1px solid var(--line-strong,#aebdb7);border-radius:10px;background:var(--surface,#fff);padding:.7rem .9rem;color:var(--ink,#17201d);font:400 1rem/1.2 \"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;outline:none;transition:border-color 150ms ease-out,box-shadow 150ms ease-out; }.ds-mission-input::placeholder { color:var(--muted,#5d6a65);opacity:.78; }.ds-mission-input:hover { border-color:var(--accent,#087f70); }.ds-mission-input:focus { border-color:var(--accent,#087f70);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent,#087f70) 16%,transparent); }"
    },
    {
      "name": "Hint Button",
      "kind": "button",
      "refersTo": "button-hint",
      "description": "Special-cost halfway hint action, visually separate from primary navigation.",
      "html": "<button class=\"ds-hint-button\" type=\"button\"><svg class=\"ds-hint-glyph\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 4H20V6H22V18H20V20H18V22H6V20H4V18H2V6H4V4H6V2H18V4ZM14 6H12V8H10V10H8V19H10V18H12V16H14V14H16V5H14V6ZM13 13H11V11H13V13Z\"/></svg>Halfway hint</button>",
      "css": ".ds-hint-button { min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid var(--hint-line,#e8c98f);border-radius:10px;background:var(--hint-soft,#fff4df);padding:0 1rem;color:var(--hint,#9a5b0a);font:700 .875rem/1.2 \"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;transition:border-color 150ms ease-out,background-color 150ms ease-out; }.ds-hint-button:hover { border-color:var(--hint,#9a5b0a); }.ds-hint-button:focus-visible { outline:2px solid var(--accent,#087f70);outline-offset:3px; }.ds-hint-button:active { background:color-mix(in srgb,var(--hint,#9a5b0a) 12%,var(--hint-soft,#fff4df)); }.ds-hint-glyph { width:24px;height:24px;fill:currentColor;shape-rendering:crispEdges; }"
    },
    {
      "name": "Mission Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Default flat content container for cooperative and utility surfaces.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-header\"><h2>Flight log</h2><span>3 signals</span></header><div class=\"ds-card-body\"><strong>Moon</strong><p>59.1% semantic closeness</p></div></section>",
      "css": ".ds-card { overflow:hidden;border:1px solid var(--line,#cfd8d4);border-radius:14px;background:var(--surface,#fff);color:var(--ink,#17201d);font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif; }.ds-card-header { min-height:3.4rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line-strong,#aebdb7);padding:.75rem 1rem; }.ds-card-header h2 { margin:0;font-size:1rem; }.ds-card-header span,.ds-card-body p { color:var(--muted,#5d6a65);font-size:.75rem; }.ds-card-body { padding:1rem;transition:background-color 150ms ease-out; }.ds-card-body:hover { background:var(--surface-subtle,#f6f8f7); }.ds-card-body p { margin:.25rem 0 0; }"
    },
    {
      "name": "Mission Header",
      "kind": "nav",
      "description": "Flat mission identity and utility bar with lobby code and theme control.",
      "html": "<header class=\"ds-mission-header\"><a class=\"ds-brand\" href=\"#\"><span class=\"ds-brand-mark\" aria-hidden=\"true\">N</span><span><strong>Neuronauts VS</strong><small>\u25c6 live mission</small></span></a><nav class=\"ds-mission-tools\" aria-label=\"Mission utilities\"><span class=\"ds-online\">2 online</span><button class=\"ds-code\" type=\"button\">SYIF89<svg class=\"ds-copy-glyph\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 6h12v2H8zM4 2h12v2H4zm2 6h2v12H6zM2 4h2v12H2zm6 16h12v2H8zM20 8h2v12h-2zm-4-4h2v2h-2zM4 16h2v2H4z\"/></svg></button><button class=\"ds-theme\" type=\"button\" aria-label=\"Theme: System\"><svg class=\"ds-monitor-glyph\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 2h16v2H4zm0 14h16v2H4zM2 4h2v12H2zm18 0h2v12h-2zm-9 14h2v2h-2zm-3 2h8v2H8z\"/></svg></button></nav></header>",
      "css": ".ds-mission-header { min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:.75rem;border-bottom:1px solid var(--line-strong,#aebdb7);padding-bottom:.75rem;color:var(--ink,#17201d);font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif; }.ds-brand { display:flex;align-items:center;gap:.5rem;color:inherit;text-decoration:none; }.ds-brand-mark { width:40px;height:40px;display:grid;place-items:center;background:var(--accent,#087f70);color:var(--accent-contrast,#fff);clip-path:polygon(50% 0,100% 25%,90% 78%,50% 100%,10% 78%,0 25%);font-weight:900; }.ds-brand strong,.ds-brand small { display:block; }.ds-brand strong { font-size:1.125rem;font-weight:800; }.ds-brand small { margin-top:.125rem;color:var(--accent,#087f70);font-size:.75rem; }.ds-mission-tools { display:flex;align-items:center;gap:.5rem; }.ds-online { color:var(--muted,#5d6a65);font-size:.875rem; }.ds-code,.ds-theme { min-height:44px;border:1px solid var(--line-strong,#aebdb7);border-radius:10px;background:var(--surface,#fff);color:var(--ink,#17201d); }.ds-code { display:inline-flex;align-items:center;gap:.5rem;padding:0 .75rem;font:700 .875rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em; }.ds-theme { width:44px;display:grid;place-items:center; }.ds-code:hover,.ds-theme:hover { border-color:var(--accent,#087f70);color:var(--accent,#087f70); }.ds-code:focus-visible,.ds-theme:focus-visible,.ds-brand:focus-visible { outline:2px solid var(--accent,#087f70);outline-offset:3px; }.ds-copy-glyph,.ds-monitor-glyph { width:24px;height:24px;fill:currentColor;shape-rendering:crispEdges; }"
    },
    {
      "name": "Game Team Surface",
      "kind": "card",
      "refersTo": "game-team-surface",
      "description": "Simple setup surface with compact explicit red team identity.",
      "html": "<section class=\"ds-team\"><h2><b>R</b> Red Shift</h2><p>2 players \u00b7 Ready</p><button>Join Red Shift</button></section>",
      "css": ".ds-team{font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;color:var(--ink,#202228);background:var(--surface,#fff);border:0;border-radius:12px;padding:16px}.ds-team h2{display:flex;align-items:center;gap:10px;margin:0;font-size:14px;color:var(--team-red,#c9474f)}.ds-team h2 b{display:grid;place-items:center;width:26px;height:26px;border-radius:6px;background:var(--team-red-soft,#fae9ea);font-size:12px}.ds-team p{font-size:12px;color:var(--muted,#626773)}.ds-team button{min-height:44px;border:0;border-radius:8px;background:var(--surface-subtle,#eceef1);color:inherit;padding:0 16px;font:inherit}.ds-team button:hover{color:var(--team-red,#c9474f)}.ds-team button:focus-visible{outline:2px solid var(--accent,#287c70);outline-offset:3px}"
    },
    {
      "name": "Game Progress Board",
      "kind": "custom",
      "refersTo": "game-progress-board",
      "description": "Independent best-signal bars replace the retired energy collision.",
      "html": "<section class=\"ds-progress\"><label class=\"ds-red\">Red Shift <b>62.4%</b><progress max=\"100\" value=\"62.4\">62.4%</progress></label><label class=\"ds-blue\">Blue Orbit <b>48.1%</b><progress max=\"100\" value=\"48.1\">48.1%</progress></label><time>02:14</time></section>",
      "css": ".ds-progress{font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;color:var(--ink,#202228);background:var(--surface,#fff);border:0;border-radius:12px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:24px;padding:16px 20px;font-size:13px}.ds-progress label{min-width:0;font-weight:700}.ds-progress b{float:right;color:var(--ink,#202228);font-variant-numeric:tabular-nums}.ds-red{color:var(--team-red,#c9474f)}.ds-blue{color:var(--team-blue,#3f74bd)}.ds-progress progress{display:block;width:100%;height:5px;margin-top:8px;appearance:none;border:0;border-radius:3px;background:var(--surface-subtle,#eceef1);accent-color:currentColor}.ds-progress progress::-webkit-progress-bar{border-radius:3px;background:var(--surface-subtle,#eceef1)}.ds-progress progress::-webkit-progress-value{border-radius:3px;background:currentColor}.ds-progress progress::-moz-progress-bar{border-radius:3px;background:currentColor}.ds-progress time{font-variant-numeric:tabular-nums}@media(max-width:719px){.ds-progress{gap:12px;padding:14px}.ds-progress time{grid-column:1/-1;text-align:center}}"
    },
    {
      "name": "Game Guess Dock",
      "kind": "input",
      "refersTo": "game-guess-dock",
      "description": "Preview of anchored input controls; runtime measures clearance and keyboard offset.",
      "html": "<section class=\"ds-dock\"><label for=\"ds-guess\">Your team\u2019s guess</label><form><input id=\"ds-guess\" placeholder=\"Enter a word\" maxlength=\"40\"><button>Guess</button></form></section>",
      "css": ".ds-dock{font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;color:var(--ink,#202228);background:var(--surface,#fff);border:0;border-radius:12px;border-radius:0;padding:14px 24px;box-shadow:0 -8px 24px rgb(0 0 0 / .04)}.ds-dock label{display:block;margin-bottom:8px;font-size:12px}.ds-dock form{display:flex;gap:8px}.ds-dock input{flex:1;min-width:0;min-height:48px;border:0;border-radius:10px;padding:0 14px;background:var(--surface-subtle,#eceef1);color:inherit;font:inherit;font-size:16px}.ds-dock button{min-height:44px;border:0;border-radius:10px;background:var(--accent,#287c70);color:var(--accent-contrast,#fff);padding:0 16px;font:inherit}.ds-dock button:hover{background:var(--accent-hover,#20685e)}.ds-dock input:focus-visible,.ds-dock button:focus-visible{outline:2px solid var(--accent,#287c70);outline-offset:3px}.ds-dock button:active{opacity:.85}"
    },
    {
      "name": "Game Semantic Field",
      "kind": "custom",
      "description": "Borderless responsive map; opponent points remain anonymous.",
      "html": "<section class=\"ds-field\"><h2>Semantic space</h2><p>Only your team\u2019s points reveal words.</p><svg viewBox=\"0 0 320 240\" aria-label=\"Team signals around the target\" role=\"img\"><circle cx=\"160\" cy=\"120\" r=\"28\" fill=\"none\" stroke=\"var(--line-strong,#c8ccd4)\" stroke-dasharray=\"2 5\"/><circle cx=\"160\" cy=\"120\" r=\"6\" fill=\"none\" stroke=\"var(--accent,#287c70)\" stroke-width=\"2.5\"/><circle cx=\"120\" cy=\"85\" r=\"3\" fill=\"var(--team-red,#c9474f)\"/><circle cx=\"205\" cy=\"150\" r=\"3\" fill=\"var(--team-blue,#3f74bd)\"/></svg></section>",
      "css": ".ds-field{font-family:\"Avenir Next\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;color:var(--ink,#202228);background:var(--surface,#fff);border:0;border-radius:12px;overflow:hidden}.ds-field h2{margin:0;padding:16px 20px 0;font-size:14px;font-weight:600}.ds-field p{margin:4px 20px;color:var(--muted,#626773);font-size:12px}.ds-field svg{display:block;width:100%;height:300px}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Match Workspace",
    "overview": "Neuronauts uses concise mission-control language, custom Pixelarticons glyphs, and small 3D neuronaut avatars to support social semantic search. Home and lobby keep their incumbent mineral-green palette and rounded, ruled components.\n\nThe game route follows the user-pinned Linear direction: a quiet, full-width workspace with neutral light/dark surfaces, one workhorse sans, compact red/blue denoters, and a persistent bottom guess input. Setup, live play, and results share this calmer grammar. Team names, emblems, and progress communicate competition while the map and private log carry the active task.",
    "keyCharacteristics": [
      "Neutral light/dark tokens scoped to `.game-shell`; incumbent home/lobby styling remains separate.",
      "Borderless 12px game surfaces, compact spacing, and one workhorse sans.",
      "Red/blue team names, R/B emblems, small progress bars, and explicit statuses.",
      "Full-width game content with responsive roster disclosures and desktop map/log columns.",
      "Measured, keyboard-aware bottom guess controls in both cooperative and VS play.",
      "Existing Pixelarticons glyphs and neuronaut avatars preserve product identity."
    ],
    "rules": [
      {
        "name": "The Two-Factor Team Rule",
        "body": "Pair team color with a name, emblem, placement, or status. Color alone never carries team identity.",
        "section": "colors"
      },
      {
        "name": "The Workhorse Rule",
        "body": "Use Avenir Next and its system sans fallbacks throughout the game route, including VS names, scores, grades, and labels.",
        "section": "typography"
      },
      {
        "name": "The Dock Clearance Rule",
        "body": "Reserve the measured guess dock height in page flow and keep the dock above the visual viewport keyboard. Neither content nor feedback may disappear behind it.",
        "section": "layout"
      },
      {
        "name": "The Surface Rule",
        "body": "Game-route grouping uses tonal surfaces, spacing, and typography. Do not add decorative borders, airlock geometry, or collision effects.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the scoped neutral game tokens in both light and dark themes.",
      "Do group game content with tonal surfaces, spacing, and 12px corners.",
      "Do pair red/blue team color with names, R/B emblems, and clear status language.",
      "Do keep the compact independent team progress bars readable at 320px.",
      "Do preserve measured bottom input clearance, safe-area padding, and visible keyboard focus.",
      "Do preserve existing neuronaut avatars, Pixelarticons glyphs, cooperative mechanics, and result scoring."
    ],
    "donts": [
      "Don't add decorative borders, clipped airlock jaws, confrontation seams, beams, or collision animation to the game route.",
      "Don't reintroduce condensed competitive typography into the game route.",
      "Don't expose opposing words, aliases, hint origins, or interactive opponent tooltips.",
      "Don't make team identity depend on color alone.",
      "Don't apply game-route palette changes to home and lobby without a separate scoped request.",
      "Don't place a fixed guess input over scrollable content without measured clearance."
    ]
  }
